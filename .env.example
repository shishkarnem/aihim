# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PROTALK POSTGRESQL DATABASE (aihim2)
PROTALK_DB_URL="https://db.pro-talk.ru/api/proxy/query"
PROTALK_DB_NAME="aihim2"
PROTALK_DB_USER_ID="MY_PROTALK_DB_USER_ID"

# PROTALK BOT CONFIGURATION (optional fallback; primary config stored in PostgreSQL protalk_config)
PROTALK_BOT_ID="MY_PROTALK_BOT_ID"
PROTALK_BOT_TOKEN="MY_PROTALK_BOT_TOKEN"

# TELEGRAM BOT TOKEN (optional fallback; primary config stored in PostgreSQL telegram_bot_config)
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_API_BASE="https://aihim.shishkarnem.workers.dev"
